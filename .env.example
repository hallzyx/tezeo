# ---- Docker / Dokploy ------------------------------------------------------
# Public origin of the deployed app (the domain you attach in Dokploy). Used in QR codes and links.
APP_BASE_URL=https://tezeo.example.com
# Database. In compose the app reaches it as host `db`. Use a URL-safe password: `openssl rand -hex 24`
POSTGRES_USER=tezeo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tezeo

# ---- Aurora Intents ---------------------------------------------------------
# Server-side only: never expose this key to the browser or commit it.
AURORA_API_KEY=
AURORA_API_BASE=https://intents-api.aurora.dev
# "live" calls Aurora for real (real money, there is no Aurora testnet).
# "simulated" is a LOCAL DEV SIMULATOR ONLY: no funds move and the UI shows a "Demo mode" banner.
AURORA_MODE=live
# NOTE: Aurora ignores a fee sent in the request; the real fee is set per API key in the Client Portal
# (https://portal.intents.aurora.dev). This value only matters for the simulator and for validation.
TEZEO_FEE_BPS=100

# ---- Local development WITHOUT docker compose (npm run dev) -----------------
# DATABASE_URL=postgres://tezeo:change-me@localhost:5432/tezeo
# DATABASE_POOL_MAX=10

# Optional: enables /demo, a mock livestream page for the demo video (handle of the demo creator)
# DEMO_STAGE_HANDLE=vale
