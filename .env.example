# Aurora Intents. Server-side only: never expose this key to the browser or commit it.
AURORA_API_KEY=
AURORA_API_BASE=https://intents-api.aurora.dev
# "live" calls Aurora for real. "simulated" is a LOCAL DEV SIMULATOR ONLY (no real funds move).
AURORA_MODE=simulated
# NOTE: Aurora ignores a fee sent in the request; the real fee is set per API key in the Client Portal
# (https://portal.intents.aurora.dev). The app shows whatever Aurora reports. This value only
# matters for the simulator and for validation.
TEZEO_FEE_BPS=100
# Where SQLite lives
DATABASE_PATH=./data/tezeo.db
# Public base URL (used in QR codes)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
