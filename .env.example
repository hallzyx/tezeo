# Aurora Intents. Server-side only: never expose this key to the browser or commit it.
AURORA_API_KEY=
AURORA_API_BASE=https://api.intents.aurora.dev
# "live" calls Aurora for real. "simulated" is a LOCAL DEV SIMULATOR ONLY (no real funds move).
AURORA_MODE=simulated
# Tezeo fee in basis points (PRD target ~1%). Must be >= Aurora's minimum (10 bps non-stable, 2 bps stable).
TEZEO_FEE_BPS=100
# Where SQLite lives
DATABASE_PATH=./data/tezeo.db
# Public base URL (used in QR codes)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
